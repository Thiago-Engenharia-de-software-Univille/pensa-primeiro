# Copie este arquivo para .env.local e coloque a sua chave do Google AI Studio.
# Sem chave, o site funciona normalmente com o verificador local.
GEMINI_API_KEY=

# Opcionais
# GEMINI_MODEL=gemini-flash-lite-latest   # modelo usado (o Flash-Lite é o mais barato e entra no plano gratuito)
# GEMINI_LIMITE_MINUTO=10                 # máximo de conferências por minuto no site todo
# GEMINI_LIMITE_DIA=300                   # máximo de conferências por dia
